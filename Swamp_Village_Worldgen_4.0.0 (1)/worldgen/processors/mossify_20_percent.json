/*This processor is mainly used for village town centers. It changes cobblestone inside of that structure piece to mossy cobblestone with a set probablity*/
{
    "format_version": "1.21.20",
    "minecraft:processor_list": {
        "description": {
            "identifier": "minecraft:mossify_20_percent"
        },
        "processors": [
            {
                "processor_type": "minecraft:rule",
                "rules": [
                    {
                        "input_predicate": {
                            "block": "minecraft:cobblestone",
                            "predicate_type": "minecraft:random_block_match",
                            "probability": 0.2
                        },
                        "location_predicate": {
                            "predicate_type": "minecraft:always_true"
                        },
                        "output_state": {
                            "name": "minecraft:mossy_cobblestone"
                        }
                    }
                ]
            }
        ]
    }
}